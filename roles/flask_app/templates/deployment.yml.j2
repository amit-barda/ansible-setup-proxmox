---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: word
  labels:
    app: word
spec:
  replicas: 3
  selector:
    matchLabels:
      app: word
  template:
    metadata:
      labels:
        app: word
    spec:
      imagePullSecrets:
        - name: gitlab-registry
      containers:
        - name: word
          image: "gitlab.test.local:5050/{{ developer_username }}/word:latest"
          ports:
            - containerPort: 5000
          readinessProbe:
            httpGet:
              path: /health
              port: 5000
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: 5000
            initialDelaySeconds: 10
            periodSeconds: 30
---
apiVersion: v1
kind: Service
metadata:
  name: word
  labels:
    app: word
spec:
  type: NodePort
  selector:
    app: word
  ports:
    - port: 5000
      targetPort: 5000
      nodePort: 30500
